{
    "manifest_version": 3,
    "name": "CATGuard",
    "version": "1.0",
    "description": "CATGuard social media usage monitor",

    "permissions": [
        "tabs",
        "storage",
        "notifications"
    ],

    "host_permissions": [
        "https://www.instagram.com/*",
        "https://www.youtube.com/*",
        "http://127.0.0.1:5000/*"
    ],

    "background": {
        "service_worker": "background.js"
    },

    "content_scripts": [
        {
            "matches": [
                "https://www.instagram.com/*",
                "https://www.youtube.com/*"
            ],
            "js": [
                "content.js"
            ]
        }
    ],

    "action": {
        "default_title": "CATGuard"
    }
}